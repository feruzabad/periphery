############################################
# 🦎 KOMODO - remote Periphery environment #
############################################
# cp env.example .env && chmod 600 .env

TZ=Europe/Berlin

## Core's Tailscale sidecar: its name, and its Tailscale IP
## (`tailscale ip -4 komodo`). Containers can't use MagicDNS, so the name is pinned to
## the IP inside the container; the IP stays the same while the device exists.
CORE_HOST=komodo.<tailnet>.ts.net
CORE_TAILSCALE_IP=100.x.y.z

## Server name in Komodo (created on first connect when an onboarding key is set)
PERIPHERY_CONNECT_AS=remote-1

## Create an Onboarding Key in the Komodo UI (Server settings). Remove it from
## this file and from the UI once the server shows up.
PERIPHERY_ONBOARDING_KEY=

PERIPHERY_ROOT_DIRECTORY=/etc/komodo

## Remote shell access. Disabled by default; set false to opt in.
PERIPHERY_DISABLE_TERMINALS=true
PERIPHERY_DISABLE_CONTAINER_TERMINALS=true

PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
PERIPHERY_LOGGING_PRETTY=false
